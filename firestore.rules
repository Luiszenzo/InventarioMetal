rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de usuarios
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin'
      );
    }
    
    // Reglas para la colección de tickets (propinas)
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.puedeVerPropinas == true
      );
    }
    
    // Reglas para otras colecciones (como productos o reportes)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
